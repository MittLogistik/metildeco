# Kopiera till .env.local och fyll i. .env.local läses av Next.js och ignoreras av git.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (testnycklar från https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Fylls i när webhooken skapas (stripe listen eller dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...
