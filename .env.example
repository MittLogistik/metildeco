# Kopiera till .env.local och fyll i. .env.local läses av Next.js och ignoreras av git.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (testnycklar från https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Fylls i när webhooken skapas (stripe listen eller dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Project Settings → API Keys). Använd de nya nycklarna, inte legacy anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (API Keys) – när domänen metilde.com är verifierad
RESEND_API_KEY=re_...

# Avsändare för orderbekräftelser (domänen måste vara verifierad i Resend)
RESEND_FROM=Metilde <support@metilde.com>
